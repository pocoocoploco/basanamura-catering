{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/site", "destination": "/data/site.json" },
    { "source": "/api/menu", "destination": "/data/menu.json" },
    { "source": "/api/portfolio", "destination": "/data/portfolio.json" }
  ]
}
